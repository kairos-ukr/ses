# Скопіюйте цей файл як .env і заповніть значення.
# .env не потрапляє в git — секретам там і місце.

# Токен бота від @BotFather
BOT_TOKEN=

# Supabase: Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Ключ service_role (НЕ anon). Він відкриває всю базу — нікому не пересилати.
SUPABASE_SERVICE_KEY=

# Нова Пошта: особистий кабінет → Налаштування → Безпека → API-ключ
NOVAPOSHTA_API_KEY=
